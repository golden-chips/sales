# Copy to .env and fill in. NEVER commit real values. See docs/ENVIRONMENT_VARIABLES.md
NODE_ENV=development
PORT=4000
# Runtime connection: MUST use the non-superuser golden_app role (RLS enforced)
DATABASE_URL=postgres://golden_app:CHANGE_ME@localhost:5432/golden_dev
# Owner connection: migrations + seeding only
DATABASE_ADMIN_URL=postgres://golden_owner:CHANGE_ME@localhost:5432/golden_dev
APP_DB_PASSWORD=CHANGE_ME
# >= 32 random chars each, and different from each other: openssl rand -base64 48
JWT_SECRET=
PLATFORM_JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_LIMIT_PER_MIN=10
LOG_LEVEL=info
# Seeding (first run only)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
GOLDEN_OWNER_EMAIL=
GOLDEN_OWNER_PASSWORD=
